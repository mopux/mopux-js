{
  "name": "@mopux/cli",
  "version": "0.1.0",
  "description": "Command line client for the Mopux API",
  "license": "MIT",
  "author": "Mopux",
  "homepage": "https://github.com/mopux/mopux-js/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mopux/mopux-js.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/mopux/mopux-js/issues",
  "keywords": [
    "mopux",
    "cli",
    "tasks",
    "projects"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "mopux": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "compile": "node scripts/compile.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@mopux/sdk": "^0.1.0"
  },
  "devDependencies": {
    "tsup": "9.0.0",
    "vitest": "5.1.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
