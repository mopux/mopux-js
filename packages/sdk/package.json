{
  "name": "@mopux/sdk",
  "version": "0.2.0",
  "description": "Official TypeScript SDK for the Mopux API v1",
  "license": "MIT",
  "author": "Mopux",
  "homepage": "https://github.com/mopux/mopux-js/tree/main/packages/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mopux/mopux-js.git",
    "directory": "packages/sdk"
  },
  "bugs": "https://github.com/mopux/mopux-js/issues",
  "keywords": [
    "mopux",
    "api",
    "sdk",
    "projects",
    "tasks"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./webhooks": {
      "node": {
        "import": {
          "types": "./dist/webhooks-node.d.ts",
          "default": "./dist/webhooks-node.js"
        },
        "require": {
          "types": "./dist/webhooks-node.d.cts",
          "default": "./dist/webhooks-node.cjs"
        }
      },
      "import": {
        "types": "./dist/webhooks.d.ts",
        "default": "./dist/webhooks.js"
      },
      "require": {
        "types": "./dist/webhooks.d.cts",
        "default": "./dist/webhooks.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --exclude tests/integration/**",
    "typecheck": "tsc --noEmit",
    "generate": "openapi-typescript spec/openapi.yaml -o src/generated/openapi.ts",
    "sync-spec": "node scripts/sync-spec.mjs && npm run generate",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "test:integration": "vitest run tests/integration"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "tsup": "9.0.0",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
