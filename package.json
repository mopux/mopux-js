{
  "name": "mopux-js",
  "private": true,
  "description": "Official TypeScript SDK and CLI for the Mopux API",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build -w @mopux/sdk && npm run build -w @mopux/cli",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
